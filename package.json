{
  "name": "rodrigo-castro-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,mjs,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{json,mjs,md}\"",
    "verify": "node scripts/verify-site.mjs",
    "sync:github": "node scripts/update-github-snapshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
