---
import { profile } from '../data/profile';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label={site.labels.home}>
      <span class="brand-mark" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 64 64" fill="none">
          <g
            stroke="currentColor"
            stroke-width="5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 43V27m0 5q3-6 9-5M44 29q-12-8-12 6t12 7" />
          </g>
          <circle cx="51" cy="43" r="3" fill="var(--accent)" />
        </svg>
      </span>
      <span class="brand-name">{profile.shortName}</span>
    </a>
    <nav aria-label={site.labels.navigation}>
      {site.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <label class="sr-only" for="theme">
        {site.labels.theme}
      </label>
      <select id="theme" class="header-theme" aria-label={site.labels.theme}>
        <option value="system">{site.labels.system}</option>
        <option value="light">{site.labels.light}</option>
        <option value="dark">{site.labels.dark}</option>
      </select>
      <a class="header-contact" href="#contacto">
        {site.labels.contact}
        <Icon name="arrow" size={17} />
      </a>
    </div>
  </div>
</header>
