---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  description?: string;
}
const { number, eyebrow, title, description } = Astro.props;
---

<div class="section-heading" data-reveal>
  <p class="eyebrow">
    <span class="section-number">{number}</span>
    {eyebrow}
  </p>
  <h2>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>
